bin/
# CI-generated deployment defaults (written by scripts/builddefaults.sh from
# repository secrets or .env). Never commit; local builds keep fail-closed
# OSS defaults.
internal/config/builddefaults_gen.go
# Local build-time deployment values (see .env.example).
.env

# Desktop shell (Electron) dependencies and build output.
desktop/node_modules/
desktop/dist/

# NSIS installer staging and output (packaging/windows/crispy-companion.nsi
# reads its payload from packaging/windows/stage).
packaging/windows/stage/
crispy-companion-windows-amd64-setup.exe
crispy-companion-windows-amd64.zip
